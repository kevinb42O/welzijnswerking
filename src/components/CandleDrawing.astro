---
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const candles = compact ? [{x:78,y:65,h:24},{x:180,y:45,h:32},{x:282,y:65,h:24}] : [{x:78,y:111,h:99},{x:180,y:42,h:131},{x:282,y:96,h:114}];
---
<svg class:list={['candle-drawing', compact ? 'candle-compact' : 'candle-full']} viewBox={compact ? '42 0 276 146' : '42 -4 276 394'} width="360" height={compact ? '190' : '509'} fill="none" aria-hidden="true" focusable="false">
  <g stroke="#f0e8cf" stroke-linecap="round" stroke-linejoin="round">
    {candles.map(({x,y,h}) => <g>
      <path d={`M${x-11} ${y}q11 -4 22 0l-1 ${h}q-10 4 -20 0Z`} stroke-width="2.3" />
      <path d={`M${x-10} ${y+2}q4 0 4 10v8q0 7 4 5l1 -13q1 -6 5 -2l1 15q1 6 5 1V${y+3}`} stroke-width="1.2" />
      <path d={`M${x-17} ${y+h+2}q17 -5 34 0l-3 9q-14 5 -28 0Z`} stroke-width="2.3" />
      <path d={`M${x-14} ${y+h+5}q14 4 28 0M${x+6} ${y+35}v${Math.max(h-43,1)}`} stroke-width=".9" />
      <path d={`M${x} ${y-6}c-16 -1 -13 -15 -7 -23 4 -5 6 -10 6 -15 4 10 15 17 13 27 -1 7 -6 11 -12 11Z`} fill="#e9cb88" stroke="#e9cb88" stroke-width="1" />
      <path d={`M${x} ${y-7}v7`} stroke-width="1.3" />
    </g>)}
    {compact ? <g stroke-width="2.3"><path d="M74 104c0 29 42 29 91 29h30c49 0 91 0 91-29M82 104c0 21 39 21 83 21h30c44 0 83 0 83-21M176 92v51m8-51v51" /></g> : <>
      <g stroke-width="2.3"><path d="M74 226c-1 60 43 69 83 83 12 4 15 12 17 18M82 226c0 49 39 56 78 71 12 5 19 14 20 22M278 226c0 49-39 56-78 71-12 5-19 14-20 22M286 226c1 60-43 69-83 83-12 4-15 12-17 18M175 188v142m10-142v142M172 331q8 5 16 0l5 9h-26Z" />
      <path d="M167 341c-1 12-12 18-27 24q40 14 80 0c-15-6-26-12-27-24M140 365v7q40 15 80 0v-7" /></g>
      <g stroke-width=".9"><path d="M79 241q7 30 34 41m-18-5 17 10m99 10 21-9m-51-84v103m-15 39 20 1m-26 5 32 1m-43 9q30 8 59 0" /></g>
    </>}
  </g>
</svg>
