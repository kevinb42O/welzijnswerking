---
import PhotoViewer from './PhotoViewer.astro';
import { visiblePhotos } from '../data/gallery';
import { hasLocalImage } from '../data/publication.mjs';
interface Props { previewCount?: number }
const demo = import.meta.env.DEV && (Astro.props.previewCount || 0) > 0;
const demoImage = (index: number) => `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" width="1000" height="750" viewBox="0 0 1000 750"><rect width="1000" height="750" fill="${['#244d42','#a63b32','#e8bb63','#d8dcca'][index%4]}"/><circle cx="${220+index%3*200}" cy="300" r="180" fill="none" stroke="#fbf5e9" stroke-width="2"/><path d="M0 550Q250 400 500 550T1000 550M0 580Q250 430 500 580T1000 580" fill="none" stroke="#fbf5e9" stroke-width="3"/><rect x="380" y="170" width="240" height="290" fill="#fbf5e9"/><text x="500" y="290" text-anchor="middle" fill="#244d42" font-family="sans-serif" font-size="40">DEMO</text><text x="500" y="400" text-anchor="middle" fill="#a63b32" font-family="sans-serif" font-size="100">${String(index+1).padStart(2,'0')}</text><text x="500" y="690" text-anchor="middle" fill="${index%4===2||index%4===3?'#244d42':'#fbf5e9'}" font-family="sans-serif" font-size="28">Grafische testfixture · geen editiefoto</text></svg>`)}`;
const photos = demo ? Array.from({ length: Astro.props.previewCount! }, (_, i) => ({ src: demoImage(i), year: null, alt: `Demo ${i + 1}, grafische testfixture, geen echte editiefoto`, credit: 'DEMO · geen echte editiefoto', objectPosition: 'center', variants: [] as { src: string; width: number }[] })) : visiblePhotos;
---
{photos.length > 0 && <section id="sfeerbeelden" class="memories section" data-photo-gallery aria-labelledby="memories-title">
  <div class="container"><div class="gallery-heading"><div><h2 id="memories-title">Foto’s van vorige edities</h2></div><p>Foto’s van vorige edities, met het jaar en de fotograaf bij elk beeld.</p></div>{demo && <p class="demo-banner">DEMO / GEEN ECHTE EDITIEFOTO · Alleen zichtbaar in development</p>}
    <div class="gallery-grid" data-count={photos.length} data-small={photos.length <= 4 || undefined}>{photos.map((photo,index) => <figure class:list={['gallery-item',{'desktop-tail':index===photos.length-1 && photos.length%3===1,'desktop-pair':photos.length%3===2 && index>=photos.length-2,'mobile-tail':index===photos.length-1 && photos.length%2===1}]}>
      <a class="gallery-open" href={photo.src} data-photo-open data-motion-frame data-index={index} data-src={photo.src} data-alt={photo.alt} data-caption={`${photo.year ? `${photo.year} · ` : ''}${photo.credit}`} aria-label={`Vergroot: ${photo.alt}`}>
        <img src={photo.src} srcset={photo.variants?.filter(v=>v.src.startsWith('/images/event/') && hasLocalImage(v.src) && Number.isInteger(v.width) && v.width>0).map(v=>`${v.src} ${v.width}w`).join(', ') || undefined} sizes={photos.length===1 ? '(max-width: 767px) calc(100vw - 40px), 720px' : '(max-width: 600px) calc(50vw - 28px), (max-width: 1440px) 45vw, 600px'} alt={photo.alt} width="1000" height="750" loading="lazy" style={{objectPosition:photo.objectPosition || 'center'}} />
        <span class="photo-year">{demo ? 'DEMO / GEEN ECHTE EDITIEFOTO' : photo.year} · Vergroot foto</span>
      </a><figcaption><span class="photo-description">{photo.alt}</span>{photo.credit}</figcaption>
    </figure>)}</div>
  </div>
  <PhotoViewer initialSrc={photos[0].src} />
</section>}
