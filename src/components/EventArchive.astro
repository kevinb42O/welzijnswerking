---
import PhotoViewer from './PhotoViewer.astro';
const album = 'https://www.facebook.com/permalink.php?story_fbid=pfbid02mnYXrpdC19N5fsG8AepACcd7QGvm1z3ucA3NtRZPXMGPviJKsGgHrPiZ4EnR3xyRl&id=100066480021669';
const photos = [
  { index: '07', label: 'Vrijwilligers in de keuken', alt: 'Vrijwilligers bij de warme maaltijd achter de schermen van het kerstfeest in 2025.', position: '50% 45%' },
  { index: '01', label: 'Gasten aan tafel', alt: 'Gasten zitten samen aan een lange feesttafel in het Kursaal tijdens het kerstfeest van 2025.', position: '50% 45%' },
  { index: '34', label: 'Desserts afwerken', alt: 'Vrijwilligers werken een reeks dessertborden af voor het kerstfeest van 2025.', position: '50% 50%' },
  { index: '17', label: 'Samen aan tafel', alt: 'Vrijwilligers bedienen gasten aan de lange gedekte tafels tijdens het kerstfeest van 2025.', position: '50% 50%' },
  { index: '37', label: 'Een feestelijk dessert', alt: 'Dessertborden staan klaar achter de schermen van het kerstfeest van 2025.', position: '50% 60%' },
  { index: '25', label: 'Samen vieren in het Kursaal', alt: 'De feestzaal van het Kursaal vol gasten aan gedekte tafels tijdens het kerstfeest van 24 december 2025.', position: '50% 55%' },
];
---
<section class="event-archive section" data-photo-gallery aria-labelledby="event-archive-title">
  <div class="container">
    <div class="event-archive-opening">
      <div class="event-archive-heading">
        <h2 id="event-archive-title">Kerstavond 2025 in beeld</h2>
        <p>Een terugblik op het kerstfeest in het Kursaal: de maaltijd, de vrijwilligers en de dansvloer.</p>
        <p class="event-photo-hint">Klik op een foto om ze te vergroten.</p>
      </div>
      <figure class="event-photo-lead">
        <a href="/images/event/2025-facebook-31-1536.webp" data-photo-open data-motion-frame data-alt="Gasten dansen samen in het Kursaal tijdens de kerstavond van 2025." data-caption="Kerstavond 2025 · Tijd om te dansen. Welzijnswerking Oostende / Facebook" aria-label="Vergroot: Tijd om te dansen">
          <img data-motion-surface src="/images/event/2025-facebook-31-960.webp" srcset="/images/event/2025-facebook-31-480.webp 480w, /images/event/2025-facebook-31-960.webp 960w, /images/event/2025-facebook-31-1536.webp 1536w" sizes="(min-width: 1001px) 720px, calc(100vw - 40px)" width="960" height="720" alt="Gasten dansen samen in het Kursaal tijdens de kerstavond van 2025." loading="lazy" />
        </a>
        <figcaption><span>Kerstavond 2025 · Tijd om te dansen.</span><a href={album} target="_blank" rel="noopener noreferrer">Welzijnswerking Oostende / Facebook</a></figcaption>
      </figure>
    </div>
    <details class="event-photos-disclosure">
      <summary class="button event-photo-toggle"><span class="label-more">Toon meer foto’s ({photos.length})</span><span class="label-less">Toon minder foto’s</span><svg class="button-icon event-photo-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
    <div class="event-photo-grid">{photos.map(photo => {
      const isHall = photo.index === '25';
      const prefix = `/images/event/2025-facebook-${photo.index}-`;
      return <figure>
        <a class:list={['archive-photo-frame', { 'archive-photo-frame--hall': isHall }]} href={`${prefix}${isHall ? '1600' : '1536'}.webp`} data-photo-open data-motion-frame data-alt={photo.alt} data-caption={`Kerstavond 2025 · ${photo.label}. Welzijnswerking Oostende / Facebook`} aria-label={`Vergroot: ${photo.label}`}>
          <img data-motion-surface src={`${prefix}${isHall ? '1200' : '960'}.webp`} srcset={`${prefix}${isHall ? '640' : '480'}.webp ${isHall ? '640' : '480'}w, ${prefix}${isHall ? '1200' : '960'}.webp ${isHall ? '1200' : '960'}w`} sizes="(max-width: 767px) calc(100vw - 40px), 680px" width={isHall ? 1200 : 960} height={isHall ? 632 : 720} alt={photo.alt} loading="lazy" style={{objectPosition:photo.position}} />
        </a>
        <figcaption><h3>{photo.label}</h3></figcaption>
      </figure>;
    })}</div>
    </details>
    <a class="text-link event-album-link" href={album} target="_blank" rel="noopener noreferrer">Bekijk alle 38 foto’s bij Welzijnswerking Oostende</a>
  </div>
  <PhotoViewer id="event-lightbox" initialSrc="/images/event/2025-facebook-31-1536.webp" label="Foto’s van kerstavond 2025" />
</section>
<style>
.event-archive{background:var(--surface);padding-block:64px}
.event-archive-opening{display:grid;gap:32px;align-items:center}
.event-archive-heading h2{max-width:420px;font-size:var(--heading-editorial);line-height:1.15}
.event-archive-heading>p{max-width:370px;margin-top:24px}
.event-archive-heading .event-photo-hint{font-size:.875rem;color:var(--text-muted);margin-top:16px}
.event-photo-lead>a,.archive-photo-frame{display:block;cursor:zoom-in;overflow:hidden;border-radius:12px}
.event-photo-lead>a{border-radius:32px 12px 12px 12px}
.event-photo-lead img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;object-position:center 60%}
.event-photo-lead figcaption{display:grid;gap:2px;padding-top:12px;font-size:var(--type-caption);line-height:1.6;color:var(--text-muted)}
.event-photo-lead figcaption a{color:var(--link);justify-self:start}
.event-photos-disclosure{margin-top:28px}
.event-photo-toggle{list-style:none;cursor:pointer;width:fit-content;max-width:100%}
.event-photo-toggle::-webkit-details-marker{display:none}
.event-photo-toggle::marker{content:""}
.event-photo-toggle .label-less,.event-photos-disclosure[open] .label-more{display:none}
.event-photos-disclosure[open] .label-less{display:inline}
.event-photo-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px 16px;margin-top:40px;align-items:start}
.event-photo-grid figure{min-width:0}
.event-photo-grid figure:nth-child(1),.event-photo-grid figure:nth-child(4){grid-column:1/-1}
.archive-photo-frame{aspect-ratio:4/3}
.archive-photo-frame--hall{aspect-ratio:19/10}
.archive-photo-frame img{display:block;width:100%;height:100%;object-fit:cover}
.event-photo-grid figcaption{padding-top:12px}
.event-photo-grid h3{font:400 var(--type-photo-title)/1.45 var(--sans);letter-spacing:0;color:var(--text);margin:0}
.event-album-link{margin-top:36px}
@media(min-width:768px){
  .event-archive{padding-block:88px}
  .event-photo-grid{grid-template-columns:repeat(12,minmax(0,1fr));gap:48px 48px;margin-top:64px}
  .event-photo-grid figure:nth-child(1),.event-photo-grid figure:nth-child(4){grid-column:span 7}
  .event-photo-grid figure:nth-child(2),.event-photo-grid figure:nth-child(3){grid-column:span 5}
  .event-photo-grid figure:nth-child(5),.event-photo-grid figure:nth-child(6){grid-column:span 6}
  .event-photo-grid figure:nth-child(2){padding-top:72px}
  .event-photo-grid figure:nth-child(2) .archive-photo-frame{aspect-ratio:4/5}
  .event-photo-grid figure:nth-child(3){align-self:center}
  .event-photo-grid figure:nth-child(4) .archive-photo-frame{aspect-ratio:3/2}
  .event-photo-grid figure:nth-child(6){padding-top:48px}
}
@media(min-width:1001px){
  .event-archive-opening{grid-template-columns:.85fr 1.4fr;gap:72px}
  .event-photo-lead>a{border-radius:48px 12px 12px 12px}
}
</style>
