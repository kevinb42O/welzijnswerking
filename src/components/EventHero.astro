---
import { event as sourceEvent, price } from '../data/event';
import { ticketState } from '../data/publication.mjs';
interface Props { eventOverride?: typeof sourceEvent }
const event = import.meta.env.DEV && Astro.props.eventOverride ? Astro.props.eventOverride : sourceEvent;
const ticket = ticketState(event.ticketStatus, event.ticketsUrl);
const registrationClosed = event.ticketStatus === 'sold_out' || event.ticketStatus === 'closed';
const hasRegistrationInfo = Boolean(event.registrationMethod) && !registrationClosed;
const titleWords = event.title.split(/\s+/);
const heroHours = event.startTime?.replace(/ uur$/, '') + (event.endTime ? ` – ${event.endTime.replace(/ uur$/, '')} uur` : ' uur');
const heroDate = new Intl.DateTimeFormat('nl-BE', { weekday: 'long', day: 'numeric', month: 'long', timeZone: event.timezone }).format(new Date(`${event.dateISO}T12:00:00Z`));
---
<section id="home" class="hero hero--invitation" aria-labelledby="hero-title">
  <div class="hero-invitation">
    <div class="hero-inner">
      <div class="hero-copy">
      <h1 id="hero-title">{titleWords.map((word, index) => <Fragment>{index > 0 && ' '}<span class:list={["hero-word", { "hero-word--accent": word.toLocaleLowerCase("nl-BE") === "kerst" }]}><span class="hero-word-text">{word}</span></span></Fragment>)}</h1>
      <p class="hero-intro">{event.intro}</p>
      {event.eligibility && <p class="hero-eligibility">{event.eligibility}</p>}
      <dl class="hero-details">
        <div><dt><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4M17 3v4M3 10h18"/></svg>Wanneer</dt><dd><time datetime={event.dateISO}>{heroDate} {event.year}</time>{event.startTime && <span class="hero-detail-note">{heroHours}</span>}</dd></div>
        <div><dt><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>Waar</dt><dd>{event.placeName}<span class="hero-detail-note">Oostende</span></dd></div>
        <div><dt><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3a2 2 0 0 0 0 4v3a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-3a2 2 0 0 0 0-4V7Z"/><path d="M9 8v1M9 12v1M9 16v1"/></svg>Deelname</dt><dd>{price}<span class="hero-detail-note">Per persoon</span></dd></div>
      </dl>
      <a class="button" href={ticket.url || (hasRegistrationInfo ? '#inschrijven' : '#praktisch')} {...(ticket.url ? {target:'_blank',rel:'noopener noreferrer'} : {})}>{ticket.url ? ticket.label : (hasRegistrationInfo ? 'Ontdek hoe je inschrijft' : 'Praktische info & deelname')}{!ticket.url && <svg class="button-icon button-icon--forward" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h17M12 4l8 8-8 8"/></svg>}</a>
      </div>
    </div>
    <picture class="hero-photo hero-photo--poster">
      <img src="/images/event/kerstfeest-2026-1254.webp" srcset="/images/event/kerstfeest-2026-640.webp 640w, /images/event/kerstfeest-2026-1000.webp 1000w, /images/event/kerstfeest-2026-1254.webp 1254w" sizes="(min-width: 1001px) 53vw, 100vw" width="1254" height="1254" alt="Affiche: hartverwarmend kerstfeest voor alleenstaande senioren, 24 december 2026 in Kursaal Oostende, van 17.00 tot 21.00 uur. Deelname: € 5 per persoon. Welzijnswerking." loading="eager" fetchpriority="high" />
    </picture>
  </div>
</section>
