---
interface Props { audit?: boolean }
const { audit = false } = Astro.props;
const image = (file: string) => `/dev-preview/research-image/${file}`;
const kw = 'https://kw.be/nieuws/samenleving/wendy-van-wanten-en-zoon-clement-dienen-op-tijdens-kerstfeest-voor-alleenstaanden-amai-wat-een-knappe-jongen-hij-lijkt-sprekend-op-zijn-vader/';
const focus = 'https://focus-wtv.be/nieuws/kerstfeest-kursaal-voor-750-senioren-en-alleenstaanden';
const ster = 'https://sterartiesten.be/video-wendy-van-wanten-en-clement-laten-gouden-hart-zien-en-helpen-als-vrijwilligers-op-een-kerstfeest-voor-alleenstaanden-in-oostende/';
---
{import.meta.env.DEV && <section class="research-archive section" aria-labelledby="archive-image-title">
  <div class="container">
    <div class="archive-intro"><div><h2 id="archive-image-title">Vorige edities in beeld</h2></div><p>Foto’s van het kerstfeest in 2025 en 2019.</p></div>
    <figure class="archive-lead"><span class="archive-year">Kerstavond · 2025</span><img src={image('2025-kw-vrijwilligers.jpg')} width="1600" height="836" alt="Vrijwilligers poseren met een dienblad; op de achtergrond zitten gasten aan gedekte tafels in het Kursaal tijdens het kerstfeest van 2025." loading="lazy" /><figcaption>Kerstfeest 2025 · Foto: JRO, volgens het onderschrift bij <a href={kw} target="_blank" rel="noopener noreferrer">KW</a>.</figcaption></figure>
    <div class="archive-people"><figure><img src={image('2019-focus-origineel.jpg')} width="1000" height="462" alt="Gasten zitten aan lange gedekte tafels in het Kursaal; in het midden van de zaal wordt gedanst." loading="lazy" /><figcaption>Archief 2019 · Beeld bij de reportage van <a href={focus} target="_blank" rel="noopener noreferrer">Focus & WTV</a>. Individuele maker niet vermeld.</figcaption></figure><div class="archive-people-copy"><h3>Het kerstfeest in 2019</h3><p>Een feestelijke maaltijd, een gesprek aan tafel en ruimte om te dansen. De reportage uit 2019 geeft een inkijk in een eerdere editie van het kerstfeest.</p><a class="text-link" href={focus} target="_blank" rel="noopener noreferrer">Bekijk de reportage uit 2019</a></div></div>
    {audit && <div class="research-rejects"><h3>Wel gevonden, niet geselecteerd voor de website</h3><div class="research-reject-grid"><figure><img src={image('2025-vrijwilligers-videostill.jpg')} width="1156" height="676" alt="Vrijwilligers tijdens een interview op het kerstfeest van 2025." loading="lazy" /><figcaption>2025 · Videostill Het Nieuwsblad via <a href={ster} target="_blank" rel="noopener noreferrer">Sterartiesten</a>. Bewaard als bronreferentie; de KW-foto heeft de voorkeur voor het ontwerp.</figcaption></figure><figure><img src={image('2025-vrijwilligers-videostill-2.png')} width="812" height="452" alt="Videostill met vrijwilligers, inclusief zichtbare afspeelknoppen." loading="lazy" /><figcaption>2025 · Het Nieuwsblad via Sterartiesten. Spelerknoppen en lage resolutie; uitsluitend referentiemateriaal.</figcaption></figure><figure><img src={image('2025-aankondiging-stefaan-reuse.jpg')} width="720" height="480" alt="De buitenkant van het Kursaal op een zonnige dag." loading="lazy" /><figcaption>Stefaan Reuse · <a href="https://www.hetnieuwsvandaag.be/nl/nieuws/regio/kerstavond-voor-alleenstaanden-vanaf-65-jaar-in-kursaal-oostende/" target="_blank" rel="noopener noreferrer">Aankondiging van 16 november 2025</a>. Locatiefoto met onbekende opnamedatum, geen foto van het feest in december.</figcaption></figure></div><p>De KW-foto hierboven is visueel gecontroleerd en hoort bij de reportage van 25 december 2025 over het feest van de avond voordien. De individuele credit is in de bron afgekort tot JRO; het artikel is van Jeffrey Roos.</p></div>}

    {audit && <div class="research-rejects"><h3>Aanvullende vondsten</h3><div class="research-reject-grid">{[
      {file:'2018-kw-vrijwilligers.jpg',caption:'2018 · Vrijwilligers bij het kerstfeest. FRO / KW. Opgenomen in de website.'},
      {file:'2016-kw-kerstman.jpg',caption:'2016 · Kerstman en vrijwilligers tijdens het kerstreveillon. FRO / KW. Opgenomen in de website.'},
      {file:'2019-kw-aankondiging.jpg',caption:'21 oktober 2019 · Organisatie bij de aankondiging. GLO / KW. Geen foto van het feest in december.'},
      {file:'2025-kw-organisatie-aankondiging.jpg',caption:'14 november 2025 · Organisatie bij de aankondiging voor het Kursaal. EFO / KW. Geen foto van het feest in december.'},
    ].map(photo => <figure><img src={image(photo.file)} alt={photo.caption} loading="lazy" /><figcaption>{photo.caption}</figcaption></figure>)}</div></div>}
    <p class="research-status">Onderzoeksarchief · De website gebruikt vier geselecteerde eventbeelden met editiejaar en bron. De overige bestanden blijven beschikbaar als referentie.</p>
  </div>
</section>}
<style>
.research-archive{background:var(--page)}.archive-intro{display:grid;gap:24px;align-items:end;margin-bottom:36px}.archive-intro h2{max-width:650px}.archive-intro>p{max-width:420px}.archive-lead{position:relative}.archive-lead img,.archive-people img,.research-reject-grid img{display:block;width:100%;height:auto}.archive-year{display:inline-block;background:var(--action);color:var(--page);padding:8px 16px;margin-bottom:12px;font-size:0.9375rem}.research-archive figcaption{font-size:0.875rem;line-height:1.6;color:var(--text-muted);padding-top:12px}.archive-people{display:grid;gap:28px;margin-top:48px;align-items:center}.archive-people h3{font:600 clamp(1.6875rem,3vw,2.375rem)/1.15 var(--heading);max-width:410px;margin-bottom:20px}.archive-people-copy p{max-width:430px}.archive-people .text-link{margin-top:16px}.research-status{font-size:0.875rem;color:var(--text-muted);border-top:1px solid var(--border);padding-top:20px;margin-top:40px}.research-rejects{border-top:1px solid var(--border);margin-top:48px;padding-top:28px}.research-reject-grid{display:grid;gap:28px;margin-block:24px}.research-rejects>p{font-size:1rem;max-width:800px}
@media(min-width:768px){.archive-intro{grid-template-columns:1.3fr 1fr;gap:64px}.archive-people{grid-template-columns:1.2fr 1fr;gap:64px}.research-reject-grid{grid-template-columns:1fr 1fr}}
</style>
