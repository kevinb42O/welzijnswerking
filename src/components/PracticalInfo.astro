---
import { event as sourceEvent, price, eventDate, routeUrl, accessibilityUrl } from '../data/event';
interface Props { eventOverride?: typeof sourceEvent }
const event = import.meta.env.DEV && Astro.props.eventOverride ? Astro.props.eventOverride : sourceEvent;
import { createEventCalendar } from '../data/calendar.mjs';
import { ticketState } from '../data/publication.mjs';
import UiTloket from './UiTloket.astro';
const ticket = ticketState(event.ticketStatus, event.ticketsUrl);
const registrationClosed = event.ticketStatus === 'sold_out' || event.ticketStatus === 'closed';
const menuInfoMissing = !event.menu.length && !event.menuNote;
const detailGroups = [
  {title:'Deelname', note:null, rows:[['Deuren open',event.doorsTime],['Voor wie',event.eligibility]]},
  {title:'Het menu', note:event.menuNote, rows:[['Op het menu',event.menu.join(' · ')],['Aantal gangen',event.courseCount]]},
  {title:'Tijdens je bezoek', note:null, rows:[['Toegankelijkheid',event.accessibilityDetails],['Vervoer',event.transportDetails]]},
].map(group=>({...group,rows:group.rows.filter(([,value])=>Boolean(value))}));
const { calendar, timedCalendar, filename } = createEventCalendar(event);
const calendarUrl = import.meta.env.DEV && Astro.props.eventOverride
  ? `data:text/calendar;charset=utf-8,${encodeURIComponent(calendar)}`
  : `/${filename}`;
---

<section id="praktisch" class="practical section" aria-labelledby="practical-title">
  <div class="container registration-invitation">
    <div id="inschrijven" tabindex="-1" class="registration-heading">
      <h2 id="practical-title">Zo schuif je aan.</h2>
      <p class="invitation-inside-intro">Inschrijven kan vanaf <time datetime={event.registrationStartDate}>{event.registrationStartLabel}</time>, via een ontmoetingscentrum of het UiTloket.</p>
    </div>
    {!registrationClosed && !ticket.url && event.registrationChannel === 'meeting_centres' ? <>
      <ol class="registration-steps">
        <li><h3>Vind een ontmoetingscentrum</h3><p>Kies een van de negen ontmoetingscentra in Oostende. Betaal je liever cash? Dan kun je terecht bij het UiTloket.</p></li>
        <li><h3>Schrijf je daar in</h3><p>{event.centrePaymentText} {event.cashPaymentText}</p></li>
        <li><h3>Geniet van een warme kerstavond</h3><p><time datetime={event.dateISO}>{eventDate}</time>{event.startTime && <span class="registration-event-hours">{event.startTime}{event.endTime && ` – ${event.endTime}`}</span>}{!event.startTime && <br />}{event.placeName} · {price} per persoon</p></li>
      </ol>
      <a class="button registration-main-action" href="#ontmoetingscentra">Bekijk de 9 ontmoetingscentra <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 4v16m-6-6 6 6 6-6" /></svg></a>
    </> : <div class="registration-status"><h3>{ticket.label}</h3>{!registrationClosed && <p>{event.ticketsInfoText}</p>}{ticket.url && <a class="button" href={ticket.url} target="_blank" rel="noopener noreferrer">{ticket.label}</a>}</div>}
    {!registrationClosed && event.registrationChannel === 'meeting_centres' && <UiTloket />}
    <details class="visit-preparation">
      <summary>Goed om te weten voor je bezoek</summary>
      <div class="practical-details">
        {detailGroups.map(group => (group.rows.length > 0 || group.note) && <section class="detail-group" aria-label={group.title}>
          <h3>{group.title}</h3>
          {group.note && <p class="detail-note">{group.note}</p>}
          {group.rows.length > 0 && <dl class="additional-details">{group.rows.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>}
        </section>)}
        <section class="detail-group"><h3>De avond</h3><p>{event.mealDescription}.</p>{event.entertainmentDetails && <p>{event.entertainmentDetails}</p>}</section>
        <section class="detail-group"><h3>Je bestemming</h3><p>{event.placeName}<br />{event.address}</p>{event.room && <p>Zaal: {event.room}</p>}<div class="arrival-links"><a class="text-link" href={routeUrl} target="_blank" rel="noopener noreferrer">Plan je route</a><a class="text-link" href={accessibilityUrl} target="_blank" rel="noopener noreferrer">Bereikbaarheid Kursaal</a></div></section>
      </div>
      {(!event.startTime || !event.eligibility || menuInfoMissing) && <p>De aanvullende evenementinformatie voor {event.year} wordt hier bekendgemaakt zodra ze bevestigd is.</p>}
      <div class="agenda-note"><a class="calendar-download text-link" href={calendarUrl} download={filename}>Zet in mijn agenda <span aria-hidden="true">↓</span></a><p>{timedCalendar ? 'Deze herinnering is geen inschrijving.' : 'Datumherinnering voor de hele dag, geen reservatie.'}</p></div>
    </details>
  </div>
</section>
