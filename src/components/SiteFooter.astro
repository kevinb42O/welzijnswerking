---
import { event as sourceEvent, organization } from '../data/event';
interface Props { eventOverride?: typeof sourceEvent }
const event = import.meta.env.DEV && Astro.props.eventOverride ? Astro.props.eventOverride : sourceEvent;
const registrationClosed = event.ticketStatus === 'sold_out' || event.ticketStatus === 'closed';
const centreRegistration = !registrationClosed && event.registrationChannel === 'meeting_centres';
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-registration">
      <p>{registrationClosed ? 'Meer weten over het kerstfeest?' : 'Wil je erbij zijn op kerstavond?'}</p>
      <a class="text-link" href={centreRegistration ? '#ontmoetingscentra' : '#praktisch'}>{centreRegistration ? 'Bekijk waar je kunt inschrijven' : 'Bekijk de praktische informatie'}</a>
    </div>
    <div class="footer-main">
      <div class="footer-identity"><a href="#home" class="wordmark footer-brand" aria-label="Welzijnswerking Oostende — naar het begin"><img class="brand-image" src="/images/branding/welzijnswerking-oostende-kleuren.png" alt="Welzijnswerking Oostende" width="2172" height="724" decoding="async" /></a><p>Kerstfeest van<br/>Welzijnswerking Oostende.</p><a class="back-top" href="#home">Naar boven</a></div>
      <nav class="footer-nav" aria-label="Footernavigatie"><a href="#praktisch">Praktisch & deelname</a><a href="#verhaal">Ons verhaal</a><a href="#edities">Vorige edities</a><a href="#partners">Met dank aan</a></nav>
      <div class="footer-organization"><p>{event.organizerName}</p><address>{organization.registeredAddress.street}<br/>{organization.registeredAddress.city}</address><p class="footer-number">Ondernemingsnummer<br/>{organization.enterpriseNumber}</p>{(event.organizerContactEmail || event.phone) && <div class="footer-contact">{event.organizerContactEmail && <a href={`mailto:${event.organizerContactEmail}`}>{event.organizerContactEmail}</a>}{event.phone && <a href={`tel:${event.phone.replace(/\s/g, '')}`}>{event.phone}</a>}</div>}</div>
    </div>
    <div class="footer-bottom">
      <p>© {event.year} Welzijnswerking Oostende</p>
      <p class="maker-credit"><span>Design &amp; development</span><a href="https://www.webaanzee.be/" target="_blank" rel="noopener noreferrer"><img src="/images/branding/webaanzee.webp" alt="Webaanzee" width="640" height="77" loading="lazy" decoding="async" /></a></p>
    </div>
  </div>
</footer>
