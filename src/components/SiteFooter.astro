---
import { event as sourceEvent, organization } from '../data/event';
interface Props { eventOverride?: typeof sourceEvent }
const event = import.meta.env.DEV && Astro.props.eventOverride ? Astro.props.eventOverride : sourceEvent;
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-invitation"><p>Een warme kerstavond.<br/><em>Voor elkaar.</em></p><a class="back-top" href="#home" aria-label="Terug naar boven"><span aria-hidden="true">↑</span></a></div>
    <div class="footer-main">
      <div class="footer-identity"><a href="#home" class="wordmark footer-brand" aria-label="Welzijnswerking Oostende — naar het begin"><span>welzijns<span class="brand-second-line">werking.</span></span><span class="wordmark-city">Oostende</span></a><p>Een Oostendse traditie.<br/>Mogelijk gemaakt door mensen.</p></div>
      <nav class="footer-nav" aria-label="Footernavigatie"><span class="footer-label">Het kerstfeest</span><a href="#praktisch">Praktisch & deelname</a><a href="#verhaal">Ons verhaal</a><a href="#edities">Vorige edities</a><a href="#partners">Met dank aan</a></nav>
      <div class="footer-organization"><span class="footer-label">De vereniging</span><p>{event.organizerName}</p><address>{organization.registeredAddress.street}<br/>{organization.registeredAddress.city}</address><p class="footer-number">Ondernemingsnummer<br/>{organization.enterpriseNumber}</p>{(event.organizerContactEmail || event.phone) && <div class="footer-contact">{event.organizerContactEmail && <a href={`mailto:${event.organizerContactEmail}`}>{event.organizerContactEmail}</a>}{event.phone && <a href={`tel:${event.phone.replace(/\s/g, '')}`}>{event.phone}</a>}</div>}</div>
    </div>
    <div class="footer-bottom"><p>© {event.year} Welzijnswerking Oostende</p><p class="maker-credit">Met zorg gemaakt door <a href="https://www.webaanzee.be/" target="_blank" rel="noopener noreferrer">Webaanzee <span aria-hidden="true">↗</span></a><span class="maker-note">Een belangeloze bijdrage.</span></p></div>
  </div>
</footer>
