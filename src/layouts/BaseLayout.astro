---
import Analytics from '@vercel/analytics/astro';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/campaign.css';
import '../styles/motion.css';
import '../styles/buttons.css';
import source from '../../data/inhoud_2026.json';
import { createSeo, serializeJsonLd } from '../data/seo.mjs';
const { title, description, canonicalUrl, socialImage, socialImageAlt, structuredData } = createSeo(source, Astro.url.pathname);
const isPreview = Astro.url.pathname.startsWith('/dev-preview/');
---
<!doctype html>
<html lang="nl-BE"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#fdfbf7" /><title>{title}</title><meta name="description" content={description} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}

    <link rel="preload" href="/fonts/cooper-hewitt-book.woff2" as="font" type="font/woff2" crossorigin /><link rel="preload" href="/fonts/cooper-hewitt-semibold.woff2" as="font" type="font/woff2" crossorigin /><link rel="canonical" href={canonicalUrl} /><link rel="icon" href="/favicon.ico?v=beeldmerk-20261021" sizes="16x16 32x32 48x48" /><link rel="icon" type="image/png" href="/favicon-32.png?v=beeldmerk-20261021" sizes="32x32" /><link rel="icon" type="image/png" href="/favicon-16.png?v=beeldmerk-20261021" sizes="16x16" /><link rel="icon" type="image/svg+xml" href="/favicon.svg?v=beeldmerk-20261021" sizes="any" /><link rel="apple-touch-icon" href="/apple-touch-icon.png?v=beeldmerk-20261021" sizes="180x180" /><meta property="og:type" content="website" /><meta property="og:locale" content="nl_BE" /><meta property="og:site_name" content="Welzijnswerking Oostende" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonicalUrl} /><meta property="og:image" content={socialImage} /><meta property="og:image:secure_url" content={socialImage} /><meta property="og:image:type" content="image/jpeg" /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content={socialImageAlt} /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={socialImage} /><meta name="twitter:image:alt" content={socialImageAlt} /><script type="application/ld+json" set:html={serializeJsonLd(structuredData)} /></head><body><a class="skip-link" href="#inhoud">Ga naar de inhoud</a><slot /><Analytics /></body></html>

<script>
  import { startPageMotion } from '../scripts/motion';
  startPageMotion();
</script>
