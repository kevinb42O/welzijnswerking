      "css": ".ds-link{display:inline-flex;align-items:center;min-height:44px;min-width:44px;font-size:1rem;font-weight:500;line-height:1.7;color:var(--link,#2369a2);text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.25em;font-family:var(--font,\"Cooper Hewitt\",sans-serif);}.ds-link:hover{color:var(--action,#273a7c);text-decoration-thickness:2px}.ds-link:focus-visible{outline:3px solid var(--focus,#2369a2);outline-offset:5px;}"
