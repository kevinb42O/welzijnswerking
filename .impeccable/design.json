    {
      "name": "Primaire actie",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "De normale antraciete actie.",
      "html": "<a class=\"ds-primary\" href=\"#inschrijven\">Hoe schrijf ik me in?</a>",
      "css": ".ds-primary,.ds-inverse{display:inline-flex;align-items:center;justify-content:space-between;gap:20px;min-height:50px;border:0;border-radius:6px;text-decoration:none;line-height:1.6;font-family:var(--font,\"Public Sans\",sans-serif);}.ds-primary:hover,.ds-inverse:hover{filter:brightness(1.08);text-decoration:underline;text-underline-offset:.2em}.ds-primary:active,.ds-inverse:active{filter:brightness(.9)}.ds-primary:focus-visible,.ds-inverse:focus-visible{outline:3px solid var(--focus,#245cb2);outline-offset:5px;}.ds-primary{padding:12px 18px;background:var(--action,#292929);color:var(--page,#fafaf9);font-size:1rem;font-weight:550;}"
    },
    {
      "name": "Lichte heroactie",
      "kind": "button",
      "refersTo": "button-inverse",
      "description": "De lichte actie op het fotografische hero-oppervlak.",
      "html": "<div class=\"ds-hero-preview\"><a class=\"ds-inverse\" href=\"#inschrijven\">Hoe schrijf ik me in?</a></div>",
      "css": ".ds-primary,.ds-inverse{display:inline-flex;align-items:center;justify-content:space-between;gap:20px;min-height:50px;border:0;border-radius:6px;text-decoration:none;line-height:1.6;font-family:var(--font,\"Public Sans\",sans-serif);}.ds-primary:hover,.ds-inverse:hover{filter:brightness(1.08);text-decoration:underline;text-underline-offset:.2em}.ds-primary:active,.ds-inverse:active{filter:brightness(.9)}.ds-primary:focus-visible,.ds-inverse:focus-visible{outline:3px solid var(--focus,#245cb2);outline-offset:5px;}.ds-hero-preview{background:var(--hero-base,#302b26);padding:24px}.ds-inverse{padding:12px 22px;background:var(--page,#fafaf9);color:var(--action,#292929);font-size:.875rem;font-weight:500}.ds-inverse:focus-visible{outline-color:var(--focus-on-dark,#fff)}"
    },
    {
      "name": "Tekstlink",
      "kind": "button",
      "description": "Onderstreepte route- en informatieactie.",
      "html": "<a class=\"ds-link\" href=\"#ontmoetingscentra\">Openingsuren en info</a>",
      "css": ".ds-link{display:inline-flex;align-items:center;min-height:44px;min-width:44px;font-size:1rem;font-weight:500;line-height:1.6;color:var(--text,#242424);text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.25em;font-family:var(--font,\"Public Sans\",sans-serif);}.ds-link:hover{color:var(--action,#292929);text-decoration-thickness:2px}.ds-link:focus-visible{outline:3px solid var(--focus,#245cb2);outline-offset:5px;}"
    },
    {
      "name": "Deelnamekaart",
      "kind": "card",
      "refersTo": "participation-note",
      "description": "Een zacht neutraal vlak voor praktische deelname-informatie.",
      "html": "<aside class=\"ds-note\"><h3>Hoe schrijf ik me in?</h3><p>Inschrijven verloopt via een ontmoetingscentrum.</p></aside>",
      "css": ".ds-note{padding:24px;border:1px solid var(--border,#d5d5d0);border-radius:8px;background:var(--surface-soft,#f0f0ed);color:var(--text,#242424);font-family:var(--font,\"Public Sans\",sans-serif);}.ds-note h3{margin:0;font-size:1.375rem;font-weight:600;line-height:1.3;letter-spacing:-.02em}.ds-note p{margin:12px 0 0;font-size:1.0625rem;line-height:1.6}"
    },
    {
      "name": "Desktopnavigatie",
      "kind": "nav",
      "description": "Rustige tekstlinks en een omlijnde praktische actie.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Hoofdnavigatie\"><a href=\"#welkom\">Voor wie?</a><a class=\"ds-nav-action\" href=\"#praktisch\">Praktisch &amp; deelname</a></nav>",
      "css": ".ds-nav{display:flex;flex-wrap:wrap;align-items:center;gap:32px;color:var(--text,#242424);font-family:var(--font,\"Public Sans\",sans-serif);}.ds-nav a{position:relative;display:inline-flex;align-items:center;min-height:44px;font-size:.875rem;line-height:1.6;color:inherit;text-decoration:none}.ds-nav a:not(.ds-nav-action)::after{content:\"\";position:absolute;bottom:8px;left:0;width:100%;height:1px;background:currentColor;transform:scaleX(0);transform-origin:left;transition:transform var(--duration-fast,180ms)}.ds-nav a:hover::after{transform:scaleX(1)}.ds-nav .ds-nav-action{padding:10px 18px;border:1px solid var(--action-line,#a8a8a2);transition:background var(--duration-fast,180ms),color var(--duration-fast,180ms)}.ds-nav-action:hover{background:var(--action,#292929);color:var(--page,#fafaf9)}.ds-nav a:focus-visible{outline:3px solid var(--focus,#245cb2);outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-nav a,.ds-nav a::after{transition:none}}"
    },
    {
      "name": "FAQ-disclosure",
      "kind": "custom",
      "description": "Native details/summary met een ronde open/dicht-indicator.",
      "html": "<details class=\"ds-faq\"><summary>Kan ik ook alleen komen?<span class=\"ds-faq-indicator\" aria-hidden=\"true\"></span></summary><div class=\"ds-answer\"><p>Ja, zeker. Je kan voor jezelf inschrijven, zonder iemand mee te brengen.</p></div></details>",
      "css": ".ds-faq{border-block:1px solid var(--border,#d5d5d0);color:var(--action,#292929);font-family:var(--font,\"Public Sans\",sans-serif);}.ds-faq summary{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:76px;padding-block:20px;list-style:none;cursor:pointer;font-size:1.0625rem;line-height:1.4;font-weight:500}.ds-faq summary::-webkit-details-marker{display:none}.ds-faq summary:hover{color:var(--action,#292929)}.ds-faq summary:focus-visible{outline:3px solid var(--focus,#245cb2);outline-offset:5px;}.ds-faq-indicator{position:relative;display:block;flex-shrink:0;width:30px;height:30px;border:1px solid var(--control-line,#bdbdb7);border-radius:50%;transition:background var(--duration-fast,180ms),border-color var(--duration-fast,180ms)}.ds-faq-indicator::before,.ds-faq-indicator::after{content:\"\";position:absolute;inset:14px 9px auto;height:1px;background:currentColor;transition:transform var(--duration-detail,220ms)}.ds-faq-indicator::after{transform:rotate(90deg)}.ds-faq[open] .ds-faq-indicator{background:var(--action,#292929);border-color:var(--action,#292929);color:var(--page,#fafaf9)}.ds-faq[open] .ds-faq-indicator::after{transform:rotate(0)}.ds-answer{padding:0 48px 24px 0}.ds-answer p{margin:0;font-size:1rem;line-height:1.7;color:var(--text-muted,#5e5e5a);max-width:570px}@media(prefers-reduced-motion:reduce){.ds-faq-indicator,.ds-faq-indicator::after,.ds-faq-indicator::before{transition:none}}"
    },
    {
      "name": "Foto-viewerbediening",
      "kind": "button",
      "refersTo": "viewer-control",
      "description": "De neutraal donkere bediening; de uitsnede toont de controls zonder foto of dialog-script.",
      "html": "<div class=\"ds-viewer-controls\"><button type=\"button\">Vorige</button><button type=\"button\">Volgende</button></div>",
      "css": ".ds-viewer-controls{display:flex;justify-content:space-between;gap:16px;padding:16px;border-radius:8px;background:var(--viewer-surface,#181818);color:var(--viewer-text,#f5f5f3);font-family:var(--font,\"Public Sans\",sans-serif);}.ds-viewer-controls button{min-height:44px;padding:8px 16px;border:1px solid var(--viewer-border,#505050);border-radius:6px;background:transparent;color:inherit;font:inherit;font-size:1.125rem;line-height:1.6;cursor:pointer}.ds-viewer-controls button:focus-visible{outline:3px solid var(--focus-on-dark,#fff);outline-offset:5px}.ds-viewer-controls button:active{background:var(--viewer-hover,#303030)}@media(hover:hover){.ds-viewer-controls button:hover{background:var(--viewer-hover,#303030)}}"
    }
